{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/eslint.config.mnci.mjs",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/package.json"
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    "@nx-go/nx-go"
  ],
  "analytics": false,
  "defaultBase": "main",
  "release": {
    "projectsRelationship": "independent",
    "projects": [
      "packages/*",
      "python-packages/*",
      "!tag:type:go-lib"
    ],
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "git": {
      "commit": false,
      "tag": true,
      "push": true
    },
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk",
      "preVersionCommand": "npx nx run-many -t build --projects=packages/*,python-packages/*",
      "versionActionsOptions": {
        "skipLockFileUpdate": true
      }
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": {
        "createRelease": "github",
        "file": false
      }
    }
  },
  "generators": {
    "@nx/react:application": {
      "linter": "none",
      "unitTestRunner": "jest"
    },
    "@nx/react:library": {
      "linter": "none",
      "unitTestRunner": "jest"
    },
    "@nx/js:library": {
      "linter": "none",
      "unitTestRunner": "jest"
    }
  },
  "sync": {
    "applyChanges": true
  },
  "mnci": {
    "workspaceName": "lore-master",
    "scope": "@lore-master",
    "registry": {
      "kind": "npm"
    },
    "agent": "ubuntu-latest",
    "variableGroup": "Build",
    "ci": "github",
    "stack": {
      "testRunner": "jest"
    }
  }
}
