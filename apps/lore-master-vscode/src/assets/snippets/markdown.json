{
  "LoreMaster: Note callout": {
    "prefix": ["lm-note", "lm-callout-note"],
    "body": ["> [!NOTE]", "> ${1:Useful information the reader should know.}", "$0"],
    "description": "Callout panel: note (drawn as a panel in the preview)"
  },
  "LoreMaster: Tip callout": {
    "prefix": ["lm-tip", "lm-callout-tip"],
    "body": ["> [!TIP]", "> ${1:Helpful advice for doing it better.}", "$0"],
    "description": "Callout panel: tip"
  },
  "LoreMaster: Important callout": {
    "prefix": ["lm-important", "lm-callout-important"],
    "body": ["> [!IMPORTANT]", "> ${1:What the reader needs to know to succeed.}", "$0"],
    "description": "Callout panel: important"
  },
  "LoreMaster: Warning callout": {
    "prefix": ["lm-warning", "lm-callout-warning"],
    "body": ["> [!WARNING]", "> ${1:Something that needs the reader's attention.}", "$0"],
    "description": "Callout panel: warning"
  },
  "LoreMaster: Caution callout": {
    "prefix": ["lm-caution", "lm-callout-caution"],
    "body": ["> [!CAUTION]", "> ${1:A risk or a negative outcome.}", "$0"],
    "description": "Callout panel: caution"
  },
  "LoreMaster: Front matter": {
    "prefix": ["lm-front-matter", "lm-parent"],
    "body": ["---", "title: ${1:Page title}", "parent: ${2:./README.md}", "---", "", "$0"],
    "description": "Front matter with a title and an explicit parent page"
  },
  "LoreMaster: Mermaid diagram": {
    "prefix": ["lm-mermaid"],
    "body": ["```mermaid", "flowchart LR", "    ${1:A[Start]} --> ${2:B[End]}", "```", "$0"],
    "description": "Mermaid flowchart"
  },
  "LoreMaster: Mermaid sequence diagram": {
    "prefix": ["lm-mermaid-sequence"],
    "body": ["```mermaid", "sequenceDiagram", "    participant ${1:A}", "    participant ${2:B}", "    ${1}->>${2}: ${3:Message}", "    ${2}-->>${1}: ${4:Reply}", "```", "$0"],
    "description": "Mermaid sequence diagram"
  },
  "LoreMaster: D2 diagram": {
    "prefix": ["lm-d2"],
    "body": ["```d2", "${1:a} -> ${2:b}: ${3:label}", "```", "$0"],
    "description": "D2 diagram, drawn by the engine"
  },
  "LoreMaster: Code block": {
    "prefix": ["lm-code", "lm-fence"],
    "body": ["```${1:language}", "${2:code}", "```", "$0"],
    "description": "Fenced code block"
  },
  "LoreMaster: Table": {
    "prefix": ["lm-table"],
    "body": ["| ${1:Column 1} | ${2:Column 2} | ${3:Column 3} |", "| --- | --- | --- |", "| ${4:a} | ${5:b} | ${6:c} |", "$0"],
    "description": "Table with three columns"
  },
  "LoreMaster: Link": {
    "prefix": ["lm-link"],
    "body": ["[${1:text}](${2:https://example.com})$0"],
    "description": "Link"
  },
  "LoreMaster: Link to another page": {
    "prefix": ["lm-page-link", "lm-link-file"],
    "body": ["[${1:text}](${2:./README.OTHER.md})$0"],
    "description": "Link to another Markdown file in the repository"
  },
  "LoreMaster: Image": {
    "prefix": ["lm-image"],
    "body": ["![${1:alt text}](${2:./image.png})$0"],
    "description": "Image"
  },
  "LoreMaster: Task list": {
    "prefix": ["lm-tasks", "lm-task"],
    "body": ["- [ ] ${1:First task}", "- [ ] ${2:Second task}", "- [x] ${3:Done task}", "$0"],
    "description": "Task list"
  },
  "LoreMaster: Bullet list": {
    "prefix": ["lm-list", "lm-bullets"],
    "body": ["- ${1:one}", "- ${2:two}", "- ${3:three}", "$0"],
    "description": "Bullet list"
  },
  "LoreMaster: Numbered list": {
    "prefix": ["lm-numbered", "lm-ol"],
    "body": ["1. ${1:one}", "2. ${2:two}", "3. ${3:three}", "$0"],
    "description": "Numbered list"
  },
  "LoreMaster: Quote": {
    "prefix": ["lm-quote"],
    "body": ["> ${1:Quoted text}", "$0"],
    "description": "Block quote"
  },
  "LoreMaster: Footnote": {
    "prefix": ["lm-footnote"],
    "body": ["${1:Text}[^${2:1}]", "", "[^${2:1}]: ${3:The footnote.}", "$0"],
    "description": "Footnote reference and its definition"
  },
  "LoreMaster: Collapsible section": {
    "prefix": ["lm-details", "lm-collapse"],
    "body": ["<details>", "<summary>${1:Summary}</summary>", "", "${2:Hidden content.}", "", "</details>", "$0"],
    "description": "Collapsible section"
  },
  "LoreMaster: Horizontal rule": {
    "prefix": ["lm-rule", "lm-hr"],
    "body": ["", "---", "", "$0"],
    "description": "Horizontal rule"
  },
  "LoreMaster: Inline code": {
    "prefix": ["lm-inline"],
    "body": ["`${1:code}`$0"],
    "description": "Inline code"
  },
  "LoreMaster: Bold and italic": {
    "prefix": ["lm-bold", "lm-italic"],
    "body": ["**${1:bold}** and _${2:italic}_$0"],
    "description": "Bold and italic text"
  },
  "LoreMaster: Strikethrough": {
    "prefix": ["lm-strike"],
    "body": ["~~${1:text}~~$0"],
    "description": "Strikethrough"
  },
  "LoreMaster: Heading": {
    "prefix": ["lm-heading", "lm-h2"],
    "body": ["## ${1:Heading}", "", "$0"],
    "description": "Second-level heading"
  }
}
