    "keybindings": [
      {
        "command": "loreMaster.markdown.toggleBold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "editorTextFocus && editorLangId == markdown && config.loreMaster.markdown.shortcuts"
      },
      {
        "command": "loreMaster.markdown.toggleItalic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorLangId == markdown && config.loreMaster.markdown.shortcuts"
      },
      {
        "command": "loreMaster.markdown.toggleStrikethrough",
        "key": "alt+s",
        "when": "editorTextFocus && editorLangId == markdown && config.loreMaster.markdown.shortcuts"
      },
      {
        "command": "loreMaster.markdown.toggleInlineCode",
        "key": "alt+c",
        "when": "editorTextFocus && editorLangId == markdown && config.loreMaster.markdown.shortcuts"
      },
      {
        "command": "loreMaster.markdown.toggleCodeBlock",
        "key": "alt+shift+c",
        "when": "editorTextFocus && editorLangId == markdown && config.loreMaster.markdown.shortcuts"
      },
      {
        "command": "loreMaster.markdown.toggleQuote",
        "key": "alt+q",
        "when": "editorTextFocus && editorLangId == markdown && config.loreMaster.markdown.shortcuts"
      },
      {
        "command": "loreMaster.markdown.toggleTask",
        "key": "alt+t",
        "when": "editorTextFocus && editorLangId == markdown && config.loreMaster.markdown.shortcuts"
      },
      {
        "command": "loreMaster.markdown.increaseHeading",
        "key": "ctrl+shift+]",
        "mac": "cmd+shift+]",
        "when": "editorTextFocus && editorLangId == markdown && config.loreMaster.markdown.shortcuts"
      },
      {
        "command": "loreMaster.markdown.decreaseHeading",
        "key": "ctrl+shift+[",
        "mac": "cmd+shift+[",
        "when": "editorTextFocus && editorLangId == markdown && config.loreMaster.markdown.shortcuts"
      },
      {
        "command": "loreMaster.markdown.listEnter",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == markdown && loreMaster.markdown.inList && !suggestWidgetVisible && !editorHasSelection && !inSnippetMode"
      },
      {
        "command": "loreMaster.markdown.listIndent",
        "key": "tab",
        "when": "editorTextFocus && editorLangId == markdown && loreMaster.markdown.inList && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && !editorTabMovesFocus"
      },
      {
        "command": "loreMaster.markdown.listOutdent",
        "key": "shift+tab",
        "when": "editorTextFocus && editorLangId == markdown && loreMaster.markdown.inList && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && !editorTabMovesFocus"
      },
      {
        "command": "loreMaster.markdown.tableNextCell",
        "key": "tab",
        "when": "editorTextFocus && editorLangId == markdown && loreMaster.markdown.inTable && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && !editorTabMovesFocus"
      },
      {
        "command": "loreMaster.markdown.tablePreviousCell",
        "key": "shift+tab",
        "when": "editorTextFocus && editorLangId == markdown && loreMaster.markdown.inTable && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && !editorTabMovesFocus"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "loreMaster.markdown.openPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation@40"
        },
        {
          "command": "loreMaster.exportMarkdown",
