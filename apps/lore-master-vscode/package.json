    "configuration": {
      "title": "LoreMaster",
      "properties": {
        "loreMaster.markdown.preview.followActiveEditor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "The LoreMaster preview shows whichever Markdown file you switch to."
        },
        "loreMaster.markdown.preview.scrollSync": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Scroll the LoreMaster preview with the editor, and the editor with the preview."
        },
        "loreMaster.markdown.toc.minLevel": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 6,
          "markdownDescription": "The shallowest heading level a table of contents lists (and section numbers start from). The default of 2 leaves out the title."
        },
        "loreMaster.markdown.toc.maxLevel": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 6,
          "markdownDescription": "The deepest heading level a table of contents lists."
        },
        "loreMaster.markdown.toc.ordered": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Number the items of a table of contents (`1.`) instead of using bullets."
        },
        "loreMaster.markdown.toc.updateOnSave": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Bring the table of contents of a Markdown file up to date when it is saved. Only a file that has one, between `<!-- toc -->` and `<!-- /toc -->`, is touched."
        },
        "loreMaster.markdown.shortcuts": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Formatting shortcuts in Markdown files: bold `Ctrl+B`, italic `Ctrl+I`, strikethrough `Alt+S`, inline code `Alt+C`, code block `Alt+Shift+C`, quote `Alt+Q`, task `Alt+T`, heading level `Ctrl+Shift+]` and `Ctrl+Shift+[`. Every one is also a command and can be rebound."
        },
        "loreMaster.markdown.listEditing": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "In a Markdown list, `Enter` starts the next item (and ends the list on an empty one), and `Tab` and `Shift+Tab` nest and un-nest items and number the lists again."
        },
        "loreMaster.markdown.tableEditing": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "In a Markdown table, `Tab` and `Shift+Tab` move between cells, lining the table up as they go, and `Tab` in the last cell adds a row."
        },
        "loreMaster.markdown.formatTablesOnSave": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Line up the pipes of every table in a Markdown file when it is saved."
        },
        "loreMaster.export.formats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "html",
              "pdf",
              "png",
              "docx",
              "odt",
              "txt",
              "jira-wiki",
              "jira-adf",
              "mediawiki"
            ]
          },
          "default": [
            "html"
          ],
          "markdownDescription": "The formats ticked by default when you export a Markdown file with **LoreMaster: Export Markdown...**."
        },
        "loreMaster.export.pageSize": {
          "type": "string",
          "enum": [
            "A4",
            "A3",
            "A5",
            "Letter",
            "Legal"
          ],
          "default": "A4",
          "markdownDescription": "The paper a PDF export is printed on."
        },
        "loreMaster.export.pngWidth": {
          "type": "number",
          "default": 1000,
          "minimum": 320,
          "maximum": 4000,
          "markdownDescription": "The width in pixels of a PNG export. The image is as tall as the page."
        },
        "loreMaster.export.browserPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "The Chrome, Edge or Chromium that prints PDF and PNG exports. Leave blank to use the one installed in the usual place. The `LORE_MASTER_BROWSER` environment variable does the same."
        },
        "loreMaster.export.folder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where exported files go. Leave blank to write each next to its Markdown file. A folder (relative to the workspace, or absolute) receives the exports with the document's own folders mirrored below it, so `docs/guide.md` exported to `dist` becomes `dist/docs/guide.html`."
        },
        "loreMaster.engine.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to a locally built `lore-master-engine` binary, for development. Leave blank to use the engine bundled with the extension."
        },
        "loreMaster.pages.label": {
          "type": "string",
          "enum": [
            "title",
            "fileName"
          ],
          "default": "title",
          "enumDescriptions": [
            "Name each page by its content title (its first heading).",
            "Name each page by its file name."
          ],
          "markdownDescription": "How the **Pages** view names each page. The other name is shown beside it. Switch with the button in the view title."
        },
        "loreMaster.pages.view": {
          "type": "string",
          "enum": [
            "storage",
            "flat",
            "repo"
          ],
          "default": "storage",
          "enumDescriptions": [
            "The pages as the storage will nest them.",
            "Every page in one list.",
            "The files where they sit in the repository, folders included."
          ],
          "markdownDescription": "How the **Pages** view arranges files. Change it with the button in the view title."
        },
        "loreMaster.pages.excluded": {
          "type": "string",
          "enum": [
            "faded",
            "hidden"
          ],
          "default": "faded",
          "enumDescriptions": [
            "Show the files a storage leaves out, faded, with the reason.",
            "Hide them."
          ],
          "markdownDescription": "What the **Pages** view does with the files a storage leaves out. Switch with the eye button in the view title."
        },
        "loreMaster.pages.updateOnMove": {
          "type": "string",
          "enum": [
            "prompt",
            "always",
            "never"
          ],
          "default": "prompt",
          "enumDescriptions": [
            "Ask each time.",
            "Update without asking.",
            "Never update."
          ],
          "markdownDescription": "When you move or rename a Markdown file, keep the nesting intact: rename the dotted files that nest under it (`readme.api.md` and `readme.api.config.md`) and rewrite the `parent:` lines that name it. Links are updated by VS Code's own `markdown.updateLinksOnFileMove.enabled`."
        },
        "loreMaster.generateBeforeSync": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Run the generators (test results, API documentation) before every **Sync**, so the pages they write are as fresh as the code. **Generate and sync documentation** always does."
        },
        "loreMaster.runPrepareSteps": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "default": "ask",
          "markdownDescription": "Whether a generator's `prepare` command (the build or test run that produces what it reads) runs when you generate. `ask` shows the exact commands first; nothing runs in an untrusted workspace. CI uses `lore-master-engine generate --prepare` instead."
        },
        "loreMaster.watchDebounceSeconds": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 300,
          "markdownDescription": "In **watch mode**, how many seconds nothing may change before the changes are synced, so a burst of saves is one sync."
        },
        "loreMaster.confluence.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "The Confluence address every output uses unless it sets its own `baseUrl`, for example `https://example.atlassian.net/wiki`. Set it once in **User** settings; a workspace or folder overrides it. The token is never a setting: it is asked for and kept in the editor's secret store."
        },
        "loreMaster.outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "platform"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 60,
                "markdownDescription": "What this output is called in the tree, the sync and the settings form, so two Confluences (technical documentation, user manuals) are told apart. Unique among the outputs. Empty shows a name made from the platform and where it goes."
              },
              "platform": {
                "type": "string",
                "enum": [
                  "confluence",
                  "github-pages",
                  "github-wiki"
                ],
                "enumDescriptions": [
                  "Atlassian Confluence: Cloud, Data Center or Server.",
                  "A static site published to a branch of a GitHub repository.",
                  "The repository's GitHub wiki."
                ],
                "markdownDescription": "Where the lore goes."
              },
              "baseUrl": {
                "type": "string",
                "markdownDescription": "The Confluence address, for example `https://example.atlassian.net/wiki`. Leave empty to use `loreMaster.confluence.baseUrl`. Must be `https`."
              },
              "space": {
                "type": "string",
                "markdownDescription": "The Confluence space key the pages go in."
              },
              "parentPageId": {
                "type": "string",
                "markdownDescription": "The id of the Confluence page the tree hangs under."
              },
              "titlePrefix": {
                "type": "string",
                "markdownDescription": "Pages are titled `<prefix>: <first heading>`. Asked once at the first sync."
              },
              "direction": {
                "type": "string",
                "enum": [
                  "to-platform",
                  "two-way"
                ],
                "enumDescriptions": [
                  "Files are the source; the platform is overwritten.",
                  "Edits made on the platform are pulled back into the files."
                ],
                "markdownDescription": "Which way changes flow. Empty uses `loreMaster.defaults.direction`."
              },
              "content": {
                "type": "array",
                "markdownDescription": "The kinds of lore this output syncs, each with the folders it reads. Leave out for the whole workspace as Markdown.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "markdown"
                      ],
                      "default": "markdown",
                      "markdownDescription": "The kind of lore. Only `markdown` is built."
                    },
                    "roots": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "default": [
                        "."
                      ],
                      "markdownDescription": "Folders, relative to the workspace, this content is read from. `.` is the whole workspace."
                    },
                    "excludes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "markdownDescription": "Gitignore-style patterns this content leaves out, on top of `loreMaster.ignore`."
                    },
                    "template": {
                      "type": "string",
                      "enum": [
                        "default"
                      ],
                      "default": "default",
                      "markdownDescription": "How the pages are laid out. Only `default` is built (#97)."
                    }
                  }
                }
              },
              "mermaidMode": {
                "type": "string",
                "enum": [
                  "image",
                  "code"
                ],
                "enumDescriptions": [
                  "A code macro plus an SVG attachment rendered by the editor.",
                  "A code macro only."
                ],
                "markdownDescription": "How Mermaid diagrams are stored. Empty uses `loreMaster.defaults.mermaidMode`."
              },
              "titleCollision": {
                "type": "string",
                "enum": [
                  "fail",
                  "adopt"
                ],
                "enumDescriptions": [
                  "Stop when an unsynced file's title already exists on the platform.",
                  "Adopt the existing page."
                ],
                "markdownDescription": "What to do when an unsynced file's title already exists. Empty uses `loreMaster.defaults.titleCollision`."
              },
              "linkMode": {
                "type": "string",
                "enum": [
                  "title",
                  "id"
                ],
                "enumDescriptions": [
                  "Link by page title.",
                  "Link by page id."
                ],
                "markdownDescription": "How links between pages are written. Empty uses `loreMaster.defaults.linkMode`."
              },
              "repo": {
                "type": "string",
                "markdownDescription": "GitHub Pages or wiki: `owner/name` or a clone URL. Empty means the workspace's own `origin`."
              },
              "branch": {
                "type": "string",
                "markdownDescription": "GitHub Pages or wiki: the branch published to. Empty means `gh-pages` (Pages) or the wiki's default branch."
              },
              "path": {
                "type": "string",
                "markdownDescription": "GitHub Pages: the folder inside the branch the site is published to, so another site can share the branch. Empty owns the whole branch."
              },
              "include": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "markdownDescription": "Gitignore-style patterns this output reads even though an ignore or exclude list leaves them out. The most specific entry wins; on a tie the include does. See *Choosing what goes where*."
              },
              "exclude": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "markdownDescription": "Gitignore-style patterns this output leaves out, on top of `loreMaster.ignore`."
              },
              "template": {
                "type": "string",
                "markdownDescription": "How this output's pages are laid out. Empty is the default layout. GitHub Pages: `default`, `minimal`, `handbook` or `headless` (Markdown and a `site.json` for your own front end), or a folder holding `template.html`. Wiki: a Markdown file with `{{content}}`. Confluence: a page id or address, or a file, with `{{content}}` where the page goes. Write `./name` for a folder named like a built-in. See *Templates*."
              }
            }
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "The places the lore goes. Edit in `settings.json`, or use the **LoreMaster** sidebar. A folder's list replaces the user's; it is not merged."
        },
        "loreMaster.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Gitignore-style patterns every output leaves out of the scan, for example `CLAUDE.md` or `internal/`."
        },
        "loreMaster.skipGitignored": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Leave out Markdown that the workspace's `.gitignore` files ignore."
        },
        "loreMaster.generators": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "output"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "test-results",
                  "coverage",
                  "markdown-docs",
                  "go-docs",
                  "openapi-docs",
                  "ts-docs",
                  "python-docs",
                  "csharp-docs",
                  "dart-docs",
                  "storybook-docs"
                ],
                "markdownDescription": "What is turned into Markdown. Leave it out and the format is recognised from the files `input` selects (test reports, coverage, OpenAPI, Markdown, a Storybook); an output no parser reads is reported as a problem."
              },
              "input": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "markdownDescription": "Gitignore-style patterns selecting what to read. Empty means the type's own default."
              },
              "source": {
                "type": "string",
                "markdownDescription": "Where a generator reads from when that is not a set of files: for `storybook-docs`, the URL of a Storybook or the workspace-relative folder of its build (e.g. `storybook-static`). `input` then filters the stories by title (`Components/`, `!Internal/`)."
              },
              "output": {
                "type": "string",
                "markdownDescription": "The workspace-relative folder the pages are written to. Include it in an output's content roots for them to sync."
              },
              "title": {
                "type": "string",
                "markdownDescription": "Heads the generated index page. Empty means the type's own default."
              },
              "prepare": {
                "type": "string",
                "markdownDescription": "A shell command that produces what this generator reads (a build, a test run), run in the workspace folder. It runs only when you ask: the **Run generators** command (see `loreMaster.runPrepareSteps`), or `lore-master-engine generate --prepare` on CI. Leave empty when the files already exist."
              }
            }
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Generators write Markdown into the workspace from other project artifacts (test reports, source documentation) so it syncs like any other page."
        },
        "loreMaster.defaults.direction": {
          "type": "string",
          "enum": [
            "",
            "to-platform",
            "two-way"
          ],
          "default": "",
          "scope": "resource",
          "markdownDescription": "The direction of an output that does not set `direction`. Empty means `to-platform`."
        },
        "loreMaster.defaults.mermaidMode": {
          "type": "string",
          "enum": [
            "",
            "image",
            "code"
          ],
          "default": "",
          "scope": "resource",
          "markdownDescription": "How Mermaid diagrams are stored in an output that does not set `mermaidMode`. Empty means `image`."
        },
        "loreMaster.defaults.linkMode": {
          "type": "string",
          "enum": [
            "",
            "title",
            "id"
          ],
          "default": "",
          "scope": "resource",
          "markdownDescription": "How links are written in an output that does not set `linkMode`. Empty means `title`."
        },
        "loreMaster.defaults.titleCollision": {
          "type": "string",
          "enum": [
            "",
            "fail",
            "adopt"
          ],
          "default": "",
          "scope": "resource",
          "markdownDescription": "What an output that does not set `titleCollision` does when a title already exists. Empty means `fail`."
        },
        "loreMaster.credentials.useKeychain": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "Remember connections in the operating system's keychain (Windows Credential Manager, macOS Keychain, the Linux Secret Service), so every VS Code profile and `lore-master-engine` on the command line share them and a token is entered once. Off by default: connections stay in this editor profile's secret storage. Turning it on also remembers the connections you already have; removing a connection forgets it there too."
        },
        "loreMaster.defaults.titlePrefix": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "The title prefix of an output that does not set `titlePrefix`: its pages are titled `<prefix>: <first heading>`. Empty means the first sync asks for one (the selected parent page's title by default)."
        }
      }
    }
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/lore-master-vscode/dist",
          "format": [
            "cjs"
          ],
          "bundle": true,
          "main": "apps/lore-master-vscode/src/main.ts",
          "tsConfig": "apps/lore-master-vscode/tsconfig.app.json",
          "assets": [
            {
              "input": "apps/lore-master-vscode/src/assets",
              "glob": "**/*",
              "output": "assets"
            }
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          },
          "thirdParty": true,
          "external": [
            "vscode"
          ],
          "generatePackageJson": false
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        },
        "dependsOn": [
          "build-webview"
        ]
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "test-integration": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node apps/lore-master-vscode/integration/run.js"
        }
      },
      "package": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "outputs": [
          "{workspaceRoot}/dist/drop/lore-master-vscode-win32-x64.vsix",
          "{workspaceRoot}/dist/drop/lore-master-vscode-win32-arm64.vsix",
          "{workspaceRoot}/dist/drop/lore-master-vscode-linux-x64.vsix",
          "{workspaceRoot}/dist/drop/lore-master-vscode-linux-arm64.vsix",
          "{workspaceRoot}/dist/drop/lore-master-vscode-alpine-x64.vsix",
          "{workspaceRoot}/dist/drop/lore-master-vscode-alpine-arm64.vsix",
          "{workspaceRoot}/dist/drop/lore-master-vscode-darwin-x64.vsix",
          "{workspaceRoot}/dist/drop/lore-master-vscode-darwin-arm64.vsix"
        ],
        "options": {
          "command": "node tools/vscode-extension.cjs package apps/lore-master-vscode --sidecar lore-master-engine"
        }
      },
      "nx-release-publish": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "package"
        ],
        "options": {
          "command": "node tools/vscode-extension.cjs publish apps/lore-master-vscode --sidecar lore-master-engine"
        }
      },
      "build-webview": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/src/assets/webview/mermaid.min.js"
        ],
        "options": {
          "cwd": "apps/lore-master-vscode",
          "command": "node -e \"require('fs').mkdirSync('src/assets/webview',{recursive:true});require('fs').copyFileSync(require.resolve('mermaid/dist/mermaid.min.js'),'src/assets/webview/mermaid.min.js')\""
        }
      }
    },
    "name": "lore-master-vscode",
    "implicitDependencies": [
      "lore-master-engine"
    ],
    "tags": [
      "type:vscode-extension"
    ]
  },
  "description": "Docs as code: sync Markdown to Confluence, GitHub Pages or the wiki, and generate pages from test results, coverage, OpenAPI, Storybook and your source. In VS Code and on CI.",
  "keywords": [
    "documentation",
    "docs as code",
    "markdown",
    "confluence",
    "atlassian",
    "github pages",
    "github wiki",
    "mermaid",
    "d2",
    "diagrams",
    "junit",
    "test report",
    "code coverage",
    "lcov",
    "cobertura",
    "openapi",
    "swagger",
    "storybook",
    "godoc",
    "typedoc",
    "api documentation",
    "mcp",
    "ai agent",
    "sync",
    "publish",
    "ci"
  ],
  "galleryBanner": {
    "color": "#1c1740",
    "theme": "dark"
  },
  "homepage": "https://github.com/LoreMaster-App/LoreMaster#readme",
  "bugs": {
    "url": "https://github.com/LoreMaster-App/LoreMaster/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LoreMaster-App/LoreMaster.git"
  }
}
