      "explorer/context": [
        {
          "command": "loreMaster.exportMarkdown",
          "when": "resourceLangId == markdown || explorerResourceIsFolder",
          "group": "loreMaster@1"
        }
      ],
      "editor/context": [
        {
          "command": "loreMaster.copyMarkdownAs",
          "when": "editorLangId == markdown",
          "group": "9_cutcopypaste@99"
        }
      ],
      "view/title": [
        {
          "command": "loreMaster.addStorage",
          "when": "view == loreMaster.storages",
          "group": "navigation@1"
