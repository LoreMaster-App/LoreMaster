{
  "name": "loremaster",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "vscode-jsonrpc": "^9.0.3",
    "mermaid": "^11.12.0"
  },
  "displayName": "LoreMaster",
  "publisher": "LoreMaster",
  "preview": true,
  "icon": "lore-master.png",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/main.js",
  "activationEvents": [],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "loreMaster.engine",
        "label": "LoreMaster"
      }
    ],
    "authentication": [
      {
        "id": "lore-master-confluence",
        "label": "Confluence (LoreMaster)"
      }
    ],
    "commands": [
      {
        "command": "loreMaster.sync",
        "title": "Sync",
        "category": "LoreMaster"
      },
      {
        "command": "loreMaster.syncTo",
        "title": "Sync to…",
        "category": "LoreMaster"
      },
      {
        "command": "loreMaster.syncCurrentFile",
        "title": "Sync Current File",
        "category": "LoreMaster"
      },
      {
        "command": "loreMaster.publishPages",
        "title": "Publish to GitHub Pages",
        "category": "LoreMaster"
      },
      {
        "command": "loreMaster.addConnection",
        "title": "Add Connection",
        "category": "LoreMaster"
      },
      {
        "command": "loreMaster.addStorage",
        "title": "Add sync storage",
        "category": "LoreMaster",
        "icon": "$(add)"
      },
      {
        "command": "loreMaster.openConfig",
        "title": "Open settings",
        "category": "LoreMaster"
      },
      {
        "command": "loreMaster.removeStorage",
        "title": "Remove storage",
        "category": "LoreMaster",
        "icon": "$(trash)"
      },
      {
        "command": "loreMaster.refreshStorages",
        "title": "Refresh storages",
        "category": "LoreMaster",
        "icon": "$(refresh)"
      },
      {
        "command": "loreMaster.copyMcpConfig",
        "title": "Copy MCP Server Config",
        "category": "LoreMaster"
      },
      {
        "command": "loreMaster.refreshPages",
        "title": "Refresh pages",
        "category": "LoreMaster",
        "icon": "$(refresh)"
      },
      {
        "command": "loreMaster.checkRemote",
        "title": "Check remote status",
        "category": "LoreMaster",
        "icon": "$(cloud)"
      },
      {
        "command": "loreMaster.togglePageLabel",
        "title": "Show page titles or file names",
        "category": "LoreMaster",
        "icon": "$(symbol-string)"
      },
      {
        "command": "loreMaster.syncPage",
        "title": "Sync this page",
        "category": "LoreMaster",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "loreMaster.editStorage",
        "title": "Edit storage",
        "category": "LoreMaster",
        "icon": "$(edit)"
      },
      {
        "command": "loreMaster.runGenerators",
        "title": "Run generators",
        "category": "LoreMaster",
        "icon": "$(run-all)"
      },
      {
        "command": "loreMaster.createAgent",
        "title": "Create documentation agent",
        "category": "LoreMaster"
      },
      {
        "command": "loreMaster.addGenerator",
        "title": "Add generator",
        "category": "LoreMaster",
        "icon": "$(add)"
      },
      {
        "command": "loreMaster.runGenerator",
        "title": "Run generator",
        "category": "LoreMaster",
        "icon": "$(play)"
      },
      {
        "command": "loreMaster.editGenerator",
        "title": "Edit generator",
        "category": "LoreMaster",
        "icon": "$(edit)"
      },
      {
        "command": "loreMaster.removeGenerator",
        "title": "Remove generator",
        "category": "LoreMaster",
        "icon": "$(trash)"
      },
      {
        "command": "loreMaster.refreshGenerators",
        "title": "Refresh generators",
        "category": "LoreMaster",
        "icon": "$(refresh)"
      },
      {
        "command": "loreMaster.generateAndSync",
        "title": "Generate and sync documentation",
        "category": "LoreMaster",
        "icon": "$(debug-start)"
      },
      {
        "command": "loreMaster.toggleWatch",
        "title": "Toggle watch mode",
        "category": "LoreMaster",
        "icon": "$(eye)"
      },
      {
        "command": "loreMaster.choosePagesView",
        "title": "Arrange pages: storage tree, flat list or repository tree",
        "category": "LoreMaster",
        "icon": "$(list-tree)"
      },
      {
        "command": "loreMaster.togglePagesExcluded",
        "title": "Show or hide the files a storage leaves out",
        "category": "LoreMaster",
        "icon": "$(eye)"
      },
      {
        "command": "loreMaster.excludeFromSync",
        "title": "Do not sync...",
        "category": "LoreMaster"
      },
      {
        "command": "loreMaster.includeInSync",
        "title": "Sync this file...",
        "category": "LoreMaster"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "loreMaster",
          "title": "LoreMaster",
          "icon": "media/loremaster.svg"
        }
      ]
    },
    "views": {
      "loreMaster": [
        {
          "id": "loreMaster.sync",
          "name": "Sync"
        },
        {
          "id": "loreMaster.pages",
          "name": "Pages"
        },
        {
          "id": "loreMaster.generators",
          "name": "Generators"
        },
        {
          "id": "loreMaster.storages",
          "name": "Storages"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "loreMaster.addStorage",
          "when": "view == loreMaster.storages",
          "group": "navigation@1"
        },
        {
          "command": "loreMaster.refreshStorages",
          "when": "view == loreMaster.storages",
          "group": "navigation@2"
        },
        {
          "command": "loreMaster.checkRemote",
          "when": "view == loreMaster.pages",
          "group": "navigation@1"
        },
        {
          "command": "loreMaster.togglePageLabel",
          "when": "view == loreMaster.pages",
          "group": "navigation@2"
        },
        {
          "command": "loreMaster.refreshPages",
          "when": "view == loreMaster.pages",
          "group": "navigation@5"
        },
        {
          "command": "loreMaster.addGenerator",
          "when": "view == loreMaster.generators",
          "group": "navigation@1"
        },
        {
          "command": "loreMaster.runGenerators",
          "when": "view == loreMaster.generators",
          "group": "navigation@3"
        },
        {
          "command": "loreMaster.refreshGenerators",
          "when": "view == loreMaster.generators",
          "group": "navigation@4"
        },
        {
          "command": "loreMaster.generateAndSync",
          "when": "view == loreMaster.generators",
          "group": "navigation@2"
        },
        {
          "command": "loreMaster.toggleWatch",
          "when": "view == loreMaster.generators",
          "group": "navigation@5"
        },
        {
          "command": "loreMaster.choosePagesView",
          "when": "view == loreMaster.pages",
          "group": "navigation@3"
        },
        {
          "command": "loreMaster.togglePagesExcluded",
          "when": "view == loreMaster.pages",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "loreMaster.editStorage",
          "when": "view == loreMaster.storages && viewItem == loreMasterStorage",
          "group": "inline@1"
        },
        {
          "command": "loreMaster.removeStorage",
          "when": "view == loreMaster.storages && viewItem == loreMasterStorage",
          "group": "inline@2"
        },
        {
          "command": "loreMaster.syncPage",
          "when": "view == loreMaster.pages && viewItem == loreMasterPage",
          "group": "inline"
        },
        {
          "command": "loreMaster.runGenerator",
          "when": "view == loreMaster.generators && viewItem == loreMasterGenerator",
          "group": "inline@1"
        },
        {
          "command": "loreMaster.editGenerator",
          "when": "view == loreMaster.generators && viewItem == loreMasterGenerator",
          "group": "inline@2"
        },
        {
          "command": "loreMaster.removeGenerator",
          "when": "view == loreMaster.generators && viewItem == loreMasterGenerator",
          "group": "inline@3"
        },
        {
          "command": "loreMaster.excludeFromSync",
          "when": "view == loreMaster.pages && viewItem =~ /^(loreMasterPage|loreMasterFolder)/",
          "group": "2_selection@1"
        },
        {
          "command": "loreMaster.includeInSync",
          "when": "view == loreMaster.pages && viewItem == loreMasterLeftOutFile",
          "group": "2_selection@1"
        }
      ],
      "commandPalette": [
        {
          "command": "loreMaster.removeStorage",
          "when": "false"
        },
        {
          "command": "loreMaster.refreshStorages",
          "when": "false"
        },
        {
          "command": "loreMaster.syncPage",
          "when": "false"
        },
        {
          "command": "loreMaster.runGenerator",
          "when": "false"
        },
        {
          "command": "loreMaster.editGenerator",
          "when": "false"
        },
        {
          "command": "loreMaster.removeGenerator",
          "when": "false"
        },
        {
          "command": "loreMaster.refreshGenerators",
          "when": "false"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "loreMaster.generators",
        "contents": "No generators yet. A generator writes Markdown pages from your test reports, Go packages or OpenAPI descriptions, and they sync like any other page.\n[Add generator](command:loreMaster.addGenerator)"
      },
      {
        "view": "loreMaster.pages",
        "contents": "No Markdown pages to show yet.\n[Add sync storage](command:loreMaster.addStorage)"
      },
      {
        "view": "loreMaster.storages",
        "contents": "No sync storages yet.\n[Add sync storage](command:loreMaster.addStorage)"
      }
    ],
    "configuration": {
      "title": "LoreMaster",
      "properties": {
        "loreMaster.engine.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to a locally built `lore-master-engine` binary, for development. Leave blank to use the engine bundled with the extension."
        },
        "loreMaster.pages.label": {
          "type": "string",
          "enum": [
            "title",
            "fileName"
          ],
          "default": "title",
          "enumDescriptions": [
            "Name each page by its content title (its first heading).",
            "Name each page by its file name."
          ],
          "markdownDescription": "How the **Pages** view names each page. The other name is shown beside it. Switch with the button in the view title."
        },
        "loreMaster.pages.view": {
          "type": "string",
          "enum": [
            "storage",
            "flat",
            "repo"
          ],
          "default": "storage",
          "enumDescriptions": [
            "The pages as the storage will nest them.",
            "Every page in one list.",
            "The files where they sit in the repository, folders included."
          ],
          "markdownDescription": "How the **Pages** view arranges files. Change it with the button in the view title."
        },
        "loreMaster.pages.excluded": {
          "type": "string",
          "enum": [
            "faded",
            "hidden"
          ],
          "default": "faded",
          "enumDescriptions": [
            "Show the files a storage leaves out, faded, with the reason.",
            "Hide them."
          ],
          "markdownDescription": "What the **Pages** view does with the files a storage leaves out. Switch with the eye button in the view title."
        },
        "loreMaster.generateBeforeSync": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Run the generators (test results, API documentation) before every **Sync**, so the pages they write are as fresh as the code. **Generate and sync documentation** always does."
        },
        "loreMaster.watchDebounceSeconds": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 300,
          "markdownDescription": "In **watch mode**, how many seconds nothing may change before the changes are synced, so a burst of saves is one sync."
        },
        "loreMaster.confluence.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "The Confluence address every output uses unless it sets its own `baseUrl`, for example `https://example.atlassian.net/wiki`. Set it once in **User** settings; a workspace or folder overrides it. The token is never a setting: it is asked for and kept in the editor's secret store."
        },
        "loreMaster.outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "platform"
            ],
            "properties": {
              "platform": {
                "type": "string",
                "enum": [
                  "confluence",
                  "github-pages",
                  "github-wiki"
                ],
                "enumDescriptions": [
                  "Atlassian Confluence: Cloud, Data Center or Server.",
                  "A static site published to a branch of a GitHub repository.",
                  "The repository's GitHub wiki."
                ],
                "markdownDescription": "Where the lore goes."
              },
              "baseUrl": {
                "type": "string",
                "markdownDescription": "The Confluence address, for example `https://example.atlassian.net/wiki`. Leave empty to use `loreMaster.confluence.baseUrl`. Must be `https`."
              },
              "space": {
                "type": "string",
                "markdownDescription": "The Confluence space key the pages go in."
              },
              "parentPageId": {
                "type": "string",
                "markdownDescription": "The id of the Confluence page the tree hangs under."
              },
              "titlePrefix": {
                "type": "string",
                "markdownDescription": "Pages are titled `<prefix>: <first heading>`. Asked once at the first sync."
              },
              "direction": {
                "type": "string",
                "enum": [
                  "to-platform",
                  "two-way"
                ],
                "enumDescriptions": [
                  "Files are the source; the platform is overwritten.",
                  "Edits made on the platform are pulled back into the files."
                ],
                "markdownDescription": "Which way changes flow. Empty uses `loreMaster.defaults.direction`."
              },
              "content": {
                "type": "array",
                "markdownDescription": "The kinds of lore this output syncs, each with the folders it reads. Leave out for the whole workspace as Markdown.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "markdown"
                      ],
                      "default": "markdown",
                      "markdownDescription": "The kind of lore. Only `markdown` is built."
                    },
                    "roots": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "default": [
                        "."
                      ],
                      "markdownDescription": "Folders, relative to the workspace, this content is read from. `.` is the whole workspace."
                    },
                    "excludes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "markdownDescription": "Gitignore-style patterns this content leaves out, on top of `loreMaster.ignore`."
                    },
                    "template": {
                      "type": "string",
                      "enum": [
                        "default"
                      ],
                      "default": "default",
                      "markdownDescription": "How the pages are laid out. Only `default` is built (#97)."
                    }
                  }
                }
              },
              "mermaidMode": {
                "type": "string",
                "enum": [
                  "image",
                  "code"
                ],
                "enumDescriptions": [
                  "A code macro plus an SVG attachment rendered by the editor.",
                  "A code macro only."
                ],
                "markdownDescription": "How Mermaid diagrams are stored. Empty uses `loreMaster.defaults.mermaidMode`."
              },
              "titleCollision": {
                "type": "string",
                "enum": [
                  "fail",
                  "adopt"
                ],
                "enumDescriptions": [
                  "Stop when an unsynced file's title already exists on the platform.",
                  "Adopt the existing page."
                ],
                "markdownDescription": "What to do when an unsynced file's title already exists. Empty uses `loreMaster.defaults.titleCollision`."
              },
              "linkMode": {
                "type": "string",
                "enum": [
                  "title",
                  "id"
                ],
                "enumDescriptions": [
                  "Link by page title.",
                  "Link by page id."
                ],
                "markdownDescription": "How links between pages are written. Empty uses `loreMaster.defaults.linkMode`."
              },
              "repo": {
                "type": "string",
                "markdownDescription": "GitHub Pages or wiki: `owner/name` or a clone URL. Empty means the workspace's own `origin`."
              },
              "branch": {
                "type": "string",
                "markdownDescription": "GitHub Pages or wiki: the branch published to. Empty means `gh-pages` (Pages) or the wiki's default branch."
              },
              "path": {
                "type": "string",
                "markdownDescription": "GitHub Pages: the folder inside the branch the site is published to, so another site can share the branch. Empty owns the whole branch."
              },
              "include": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "markdownDescription": "Gitignore-style patterns this output reads even though an ignore or exclude list leaves them out. The most specific entry wins; on a tie the include does. See *Choosing what goes where*."
              },
              "exclude": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "markdownDescription": "Gitignore-style patterns this output leaves out, on top of `loreMaster.ignore`."
              }
            }
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "The places the lore goes. Edit in `settings.json`, or use the **LoreMaster** sidebar. A folder's list replaces the user's; it is not merged."
        },
        "loreMaster.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Gitignore-style patterns every output leaves out of the scan, for example `CLAUDE.md` or `internal/`."
        },
        "loreMaster.skipGitignored": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Leave out Markdown that the workspace's `.gitignore` files ignore."
        },
        "loreMaster.generators": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "output"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "test-results",
                  "go-docs",
                  "openapi-docs",
                  "ts-docs",
                  "python-docs",
                  "csharp-docs",
                  "dart-docs"
                ],
                "markdownDescription": "What is turned into Markdown."
              },
              "input": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "markdownDescription": "Gitignore-style patterns selecting what to read. Empty means the type's own default."
              },
              "output": {
                "type": "string",
                "markdownDescription": "The workspace-relative folder the pages are written to. Include it in an output's content roots for them to sync."
              },
              "title": {
                "type": "string",
                "markdownDescription": "Heads the generated index page. Empty means the type's own default."
              }
            }
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Generators write Markdown into the workspace from other project artifacts (test reports, source documentation) so it syncs like any other page."
        },
        "loreMaster.defaults.direction": {
          "type": "string",
          "enum": [
            "",
            "to-platform",
            "two-way"
          ],
          "default": "",
          "scope": "resource",
          "markdownDescription": "The direction of an output that does not set `direction`. Empty means `to-platform`."
        },
        "loreMaster.defaults.mermaidMode": {
          "type": "string",
          "enum": [
            "",
            "image",
            "code"
          ],
          "default": "",
          "scope": "resource",
          "markdownDescription": "How Mermaid diagrams are stored in an output that does not set `mermaidMode`. Empty means `image`."
        },
        "loreMaster.defaults.linkMode": {
          "type": "string",
          "enum": [
            "",
            "title",
            "id"
          ],
          "default": "",
          "scope": "resource",
          "markdownDescription": "How links are written in an output that does not set `linkMode`. Empty means `title`."
        },
        "loreMaster.defaults.titleCollision": {
          "type": "string",
          "enum": [
            "",
            "fail",
            "adopt"
          ],
          "default": "",
          "scope": "resource",
          "markdownDescription": "What an output that does not set `titleCollision` does when a title already exists. Empty means `fail`."
        }
      }
    }
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/lore-master-vscode/dist",
          "format": [
            "cjs"
          ],
          "bundle": true,
          "main": "apps/lore-master-vscode/src/main.ts",
          "tsConfig": "apps/lore-master-vscode/tsconfig.app.json",
          "assets": [
            {
              "input": "apps/lore-master-vscode/src/assets",
              "glob": "**/*",
              "output": "assets"
            }
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          },
          "thirdParty": true,
          "external": [
            "vscode"
          ],
          "generatePackageJson": false
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        },
        "dependsOn": [
          "build-webview"
        ]
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "test-integration": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node apps/lore-master-vscode/integration/run.js"
        }
      },
      "package": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "outputs": [
          "{workspaceRoot}/dist/drop/lore-master-vscode-win32-x64.vsix",
          "{workspaceRoot}/dist/drop/lore-master-vscode-win32-arm64.vsix",
          "{workspaceRoot}/dist/drop/lore-master-vscode-linux-x64.vsix",
          "{workspaceRoot}/dist/drop/lore-master-vscode-linux-arm64.vsix",
          "{workspaceRoot}/dist/drop/lore-master-vscode-alpine-x64.vsix",
          "{workspaceRoot}/dist/drop/lore-master-vscode-alpine-arm64.vsix",
          "{workspaceRoot}/dist/drop/lore-master-vscode-darwin-x64.vsix",
          "{workspaceRoot}/dist/drop/lore-master-vscode-darwin-arm64.vsix"
        ],
        "options": {
          "command": "node tools/vscode-extension.cjs package apps/lore-master-vscode --sidecar lore-master-engine"
        }
      },
      "nx-release-publish": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "package"
        ],
        "options": {
          "command": "node tools/vscode-extension.cjs publish apps/lore-master-vscode --sidecar lore-master-engine"
        }
      },
      "build-webview": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/src/assets/webview/mermaid.min.js"
        ],
        "options": {
          "cwd": "apps/lore-master-vscode",
          "command": "node -e \"require('fs').mkdirSync('src/assets/webview',{recursive:true});require('fs').copyFileSync(require.resolve('mermaid/dist/mermaid.min.js'),'src/assets/webview/mermaid.min.js')\""
        }
      }
    },
    "name": "lore-master-vscode",
    "tags": [
      "type:vscode-extension"
    ]
  },
  "description": "Gathers a project's lore: syncs your workspace's Markdown to Confluence, and publishes it as a static site on GitHub Pages.",
  "repository": {
