          "when": "view == loreMaster.pages",
          "group": "navigation@3"
        },
        {
          "command": "loreMaster.togglePagesExcluded",
          "when": "view == loreMaster.pages",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "loreMaster.editStorage",
          "when": "view == loreMaster.storages && viewItem == loreMasterStorage",
          "group": "inline@1"
        },
        {
          "command": "loreMaster.removeStorage",
          "when": "view == loreMaster.storages && viewItem == loreMasterStorage",
          "group": "inline@2"
        },
        {
          "command": "loreMaster.syncPage",
          "when": "view == loreMaster.pages && viewItem == loreMasterPage",
          "group": "inline"
        },
        {
          "command": "loreMaster.runGenerator",
          "when": "view == loreMaster.generators && viewItem == loreMasterGenerator",
          "group": "inline@1"
        },
        {
          "command": "loreMaster.editGenerator",
          "when": "view == loreMaster.generators && viewItem == loreMasterGenerator",
          "group": "inline@2"
        },
        {
          "command": "loreMaster.removeGenerator",
          "when": "view == loreMaster.generators && viewItem == loreMasterGenerator",
          "group": "inline@3"
        },
        {
          "command": "loreMaster.excludeFromSync",
          "when": "view == loreMaster.pages && viewItem =~ /^(loreMasterPage|loreMasterFolder)/",
          "group": "2_selection@1"
        },
        {
          "command": "loreMaster.includeInSync",
          "when": "view == loreMaster.pages && viewItem == loreMasterLeftOutFile",
          "group": "2_selection@1"
        }
      ],
