{
  "name": "lore-master",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "vscode-jsonrpc": "^9.0.3",
    "mermaid": "^11.12.0"
  },
  "displayName": "Lore Master",
  "publisher": "russoedu",
  "preview": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/main.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "loreMaster.syncWorkspace",
        "title": "Sync Workspace",
        "category": "Lore Master"
      },
      {
        "command": "loreMaster.syncCurrentFile",
        "title": "Sync Current File",
        "category": "Lore Master"
      },
      {
        "command": "loreMaster.addConnection",
        "title": "Add Connection",
        "category": "Lore Master"
      }
    ],
    "configuration": {
      "title": "Lore Master",
      "properties": {
        "loreMaster.engine.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to a locally built `lore-master-engine` binary, for development. Leave blank to use the engine bundled with the extension."
        }
      }
    }
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/lore-master-vscode/dist",
          "format": [
            "cjs"
          ],
          "bundle": true,
          "main": "apps/lore-master-vscode/src/main.ts",
          "tsConfig": "apps/lore-master-vscode/tsconfig.app.json",
          "assets": [
            {
              "input": "apps/lore-master-vscode/src/assets",
              "glob": "**/*",
              "output": "assets"
            }
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          },
          "thirdParty": true,
          "external": [
            "vscode"
          ],
          "generatePackageJson": false
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        },
        "dependsOn": [
          "build-webview"
        ]
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "package": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "outputs": [
          "{workspaceRoot}/dist/drop/lore-master-vscode-win32-x64.vsix",
          "{workspaceRoot}/dist/drop/lore-master-vscode-win32-arm64.vsix",
          "{workspaceRoot}/dist/drop/lore-master-vscode-linux-x64.vsix",
          "{workspaceRoot}/dist/drop/lore-master-vscode-linux-arm64.vsix",
          "{workspaceRoot}/dist/drop/lore-master-vscode-alpine-x64.vsix",
          "{workspaceRoot}/dist/drop/lore-master-vscode-alpine-arm64.vsix",
          "{workspaceRoot}/dist/drop/lore-master-vscode-darwin-x64.vsix",
          "{workspaceRoot}/dist/drop/lore-master-vscode-darwin-arm64.vsix"
        ],
        "options": {
          "command": "node tools/vscode-extension.cjs package apps/lore-master-vscode --sidecar lore-master-engine"
        }
      },
      "nx-release-publish": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "package"
        ],
        "options": {
          "command": "node tools/vscode-extension.cjs publish apps/lore-master-vscode --sidecar lore-master-engine"
        }
      },
      "build-webview": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/src/assets/webview/mermaid.min.js"
        ],
        "options": {
          "cwd": "apps/lore-master-vscode",
          "command": "node -e \"require('fs').mkdirSync('src/assets/webview',{recursive:true});require('fs').copyFileSync(require.resolve('mermaid/dist/mermaid.min.js'),'src/assets/webview/mermaid.min.js')\""
        }
      }
    },
    "name": "lore-master-vscode",
    "tags": [
      "type:vscode-extension"
    ]
  },
  "description": "Gathers a project's lore: syncs the workspace's Markdown into a documentation platform (Confluence first)."
}
