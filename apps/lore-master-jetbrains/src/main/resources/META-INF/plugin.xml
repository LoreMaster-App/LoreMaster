<idea-plugin>
    <id>app.loremaster.jetbrains</id>
    <name>LoreMaster</name>
    <vendor>LoreMaster</vendor>
    <description><![CDATA[
        <p>LoreMaster gathers a project's lore: it syncs your Markdown to Confluence, GitHub Pages and the GitHub wiki, and exports it
        to other formats. The same engine as the VS Code extension, so a team can use both.</p>
        <ul>
            <li><b>Sync to Confluence</b> (Cloud, Data Center, Server): review the plan, then sync. Credentials stay in the IDE's password safe.</li>
            <li><b>GitHub Pages and wiki</b>: check, build and publish the site with your own git.</li>
            <li><b>Generators</b>: Markdown from test reports and source documentation.</li>
            <li><b>Export</b> a Markdown file to HTML, Word, OpenDocument, PDF, PNG, plain text, Jira and MediaWiki. Mermaid diagrams are drawn.</li>
            <li>A <b>LoreMaster tool window</b> with the page tree of an output.</li>
        </ul>
        <p>Configure outputs in <code>.vscode/settings.json</code> (<code>loreMaster.outputs</code>): Tools &gt; LoreMaster: Open Project Settings.
        PDF and PNG need Chrome, Edge or Chromium installed.</p>
    ]]></description>
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="LoreMaster" displayType="BALLOON"/>
        <toolWindow id="LoreMaster" anchor="right" secondary="true" icon="AllIcons.Nodes.Folder"
                    factoryClass="loremaster.pagestree.PagesToolWindowFactory"/>
        <applicationService serviceImplementation="loremaster.pluginsettings.PluginSettingsStore"/>
        <applicationConfigurable parentId="tools" instanceId="loremaster.settings" displayName="LoreMaster"
                                 id="loremaster.settings" instance="loremaster.pluginsettings.PluginSettingsHandler"/>
    </extensions>

    <actions>
        <action id="loremaster.checkEngine"
                class="loremaster.enginecheck.CheckEngineHandler"
                text="LoreMaster: Check Engine"
                description="Start the LoreMaster engine and check that it answers">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="loremaster.exportMarkdown"
                class="loremaster.exportmarkdown.ExportMarkdownHandler"
                text="LoreMaster: Export Markdown As..."
                description="Export this Markdown file to HTML, Word, OpenDocument, PDF, PNG, plain text, Jira or MediaWiki">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="loremaster.openProjectSettings"
                class="loremaster.projectsettings.OpenProjectSettingsHandler"
                text="LoreMaster: Open Project Settings"
                description="Open .vscode/settings.json, where the loreMaster.* outputs, ignore list and generators live">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="loremaster.sync"
                class="loremaster.sync.SyncHandler"
                text="LoreMaster: Sync to Confluence..."
                description="Sync the selected Markdown files, or the whole project, to a Confluence output after reviewing the plan">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="loremaster.checkPages" class="loremaster.pages.CheckPagesHandler" text="LoreMaster: Check GitHub Pages"
                description="Compare the site with what is published, without publishing">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="loremaster.buildPages" class="loremaster.pages.BuildPagesHandler" text="LoreMaster: Build GitHub Pages Site..."
                description="Write the static site into a folder, with no git and no network">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="loremaster.publishPages" class="loremaster.pages.PublishPagesHandler" text="LoreMaster: Publish GitHub Pages"
                description="Publish the site to its branch with your own git">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="loremaster.runGenerators" class="loremaster.generators.RunGeneratorsHandler" text="LoreMaster: Run Generators"
                description="Write Markdown from test reports and source documentation">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="loremaster.toggleWatch" class="loremaster.watch.ToggleWatchHandler" text="LoreMaster: Watch Mode"
                description="Regenerate and sync only what changed, as files are saved">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="loremaster.rollback" class="loremaster.rollback.RollbackHandler" text="LoreMaster: Roll Back a Sync..."
                description="Undo an earlier sync: trash the pages it created, restore the pages it updated and the local files">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="loremaster.connect"
                class="loremaster.connection.ConnectHandler"
                text="LoreMaster: Connect to Confluence..."
                description="Sign in to Confluence and keep the credential in the IDE's password safe">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="loremaster.forgetConnection"
                class="loremaster.connection.ForgetConnectionHandler"
                text="LoreMaster: Forget Confluence Connection..."
                description="Remove a site's credential from the password safe">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
